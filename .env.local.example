# Site Configuration
# Copy this file to .env.local and update with your actual values

# Your production site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://samsilodigitalhub.vercel.app

# Google Search Console Verification Code
# Get this from: https://search.google.com/search-console
# NEXT_PUBLIC_GOOGLE_VERIFICATION=your-verification-code-here

# Bing Webmaster Verification Code
# Get this from: https://www.bing.com/webmasters
# NEXT_PUBLIC_BING_VERIFICATION=your-verification-code-here

# Google Analytics Measurement ID (GA4)
# Get this from: https://analytics.google.com
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Note: For Vercel deployment, add these as Environment Variables in your Vercel dashboard
